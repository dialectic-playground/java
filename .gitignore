# Shared ignores (identical base in every Dialectic Playground repository).
# Python tooling (scripts, test runners, docs builds)
__pycache__/
*.py[cod]
.venv/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Repository-specific (Java / Maven)
target/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

node_modules/
